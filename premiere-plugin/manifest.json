{
  "id": "com.aieventeditor.panel",
  "name": "AI Event Editor",
  "version": "0.3.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ai-event-editor",
      "label": {
        "default": "AI Event Editor"
      },
      "minimumSize": {
        "width": 320,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 650
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": {
      "domains": [
        "http://127.0.0.1:8765"
      ]
    },
    "launchProcess": {
      "extensions": [
        ".cmd"
      ]
    }
  }
}
